BETTER_AUTH_SECRET=replace-with-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=
DATABASE_URL=mysql://root:password@localhost:3306/ai-hot-trend

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ==================== 用户通知与飞书机器人 ====================

# 必填：用于 AES-256-GCM 加密数据库中的飞书 Webhook 和签名密钥。
# 必须是 32 个随机字节的 Base64 编码。可执行：
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 生产环境不要随意更换；更换后，旧的机器人配置将无法解密。
NOTIFICATION_ENCRYPTION_KEY_BASE64=

# 当前进程使用哪个调度模式：
# local      本地开发默认模式；可手动调用 dispatch/local 测试完整推送链路。
# vercel     仅用于部署到 Vercel；由 vercel.json 的每日 Cron 调用。
# cloudflare 仅用于部署到 Cloudflare；由 Worker 的五分钟 Cron 调用。
# 同一个生产数据库只能部署并启用 vercel 或 cloudflare 中的一种，避免重复推送。
NOTIFICATION_SCHEDULER_PROVIDER=local

# 仅在 NOTIFICATION_SCHEDULER_PROVIDER=vercel 时使用。
# Vercel 免费计划每天只能运行一次，因此所有用户固定在这个中国时间推送。
# 格式必须为 HH:mm，例如 09:00。local 和 cloudflare 模式忽略此配置。
NOTIFICATION_FIXED_DELIVERY_TIME=09:00

# 内部调度接口的 Bearer Token。local 手动测试和 Cloudflare Worker 必填。
# 请替换成至少 32 位随机字符串；不能暴露给浏览器，也不能提交到 Git。
# local 示例：Invoke-RestMethod 调用 /api/internal/notifications/dispatch/local 时使用它。
NOTIFICATION_DISPATCH_TOKEN=replace-with-a-long-random-token

# 仅 Vercel 部署时建议配置。Vercel Cron 会自动用它请求内部调度接口。
# 该值可与 NOTIFICATION_DISPATCH_TOKEN 不同；服务端接受任意一个正确的令牌。
# CRON_SECRET=