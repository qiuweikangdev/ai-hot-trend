BETTER_AUTH_SECRET=replace-with-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=
DATABASE_URL=mysql://root:password@localhost:3306/ai-hot-trend

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Base64 encoding of 32 random bytes; for example: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY_BASE64=
# Use local for manual development tests. Set vercel or cloudflare only in the matching deployed environment.
NOTIFICATION_SCHEDULER_PROVIDER=local
# Vercel uses a fixed daily time. Cloudflare and local mode use five-minute slots.
NOTIFICATION_SCHEDULER_RESOLUTION_MINUTES=1440
NOTIFICATION_FIXED_DELIVERY_TIME=09:00
# Used by Cloudflare Worker; Vercel Cron can use CRON_SECRET automatically.
NOTIFICATION_DISPATCH_TOKEN=replace-with-a-long-random-token